      "invalidates": ["cached_parent_predictions", "attention_outputs"]
    },
    "fusion": {
      "form": "low_rank",
      "rank": 4,
      "alpha": 4.0,
      "invalidates": ["cached_parent_predictions", "fused_representations"]
    }
  },
  "arms": [
    {"id": "head", "points": ["head"]},
    {"id": "readout", "points": ["readout"]},
    {"id": "fusion", "points": ["fusion"]},
    {"id": "head+readout", "points": ["head", "readout"]},
    {"id": "head+fusion", "points": ["head", "fusion"]},
    {"id": "readout+fusion", "points": ["readout", "fusion"]},
    {
      "id": "head+readout+fusion",
      "points": ["head", "readout", "fusion"]
