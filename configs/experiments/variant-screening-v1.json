{
  "schema_version": 1,
  "kind": "variant_screening_protocol_v1",
  "issue": 746,
  "study_issue": 742,
  "status": "registered_before_opening_s",
  "default_enabled": false,
  "final_test_access": false,
  "learning_hold": "every_job_checks_the_global_hold_before_reading_sources",
  "population": {
    "market": "US",
    "assets_per_origin": 256,
    "cohort_kind": "screening_origin_cohorts_v1",
    "cohort_salt": "mars-titan-variant-screening-v1",
    "input_policy": "historical_masked_2000_v1"
  },
  "origins": [
    {"year": 2019, "fold": "fold-014"},
    {"year": 2020, "fold": "fold-015"},
    {"year": 2021, "fold": "fold-016"},
    {"year": 2022, "fold": "fold-017"}
  ],
  "partitions": {
    "fit": "last_12_months_of_the_fold_train",
    "validation": "common_epoch_selection_with_session_ic",
    "calibration": "market_lambda_conformal_corrections_thresholds_and_output_stages",
    "screening": "evaluation_year_of_each_origin",
    "screening_blocks": "calendar_quarters_of_each_evaluation_year",
    "confirmation": {
      "fold": "fold-018",
      "year": 2023,
      "opened_by_the_screening": false,
      "reused_development": true
    },
    "final_test": {"start": "2024-01-01", "opened": false}
  },
  "seeds": [42, 43, 44, 45, 46],
  "fit": {
    "fit_months": 12,
    "epochs": 12,
    "stopping": "common_epoch",
    "selection": "common_epoch_session_ic_v1",
    "search_case": "lr1e-3",
    "precision": "fp32_strict",
    "sdpa_backend": "MATH",
    "updates_note": "Con 256 activos, unas 250 sesiones de ajuste y bloques de 1.024 filas, cada época hace unas 62 actualizaciones y el presupuesto unas 740, del orden de las 685 de los pilotos de octubre"
  },
  "selection": {
    "rule": "common_epoch_session_ic_v1",
    "applies_to": ["fit", "reader"],
    "metric": "session_ic",
    "partition": "validation",
    "eligible_epochs": "every_trained_epoch_from_1_to_the_budget",
    "seed_aggregation": "mean_of_the_seeds_in_each_session_defined_by_all_of_them",
    "smoothing_radius": 1,
    "ties": "earliest_epoch",
    "combined_outputs": "epoch_chosen_with_the_session_ic_of_the_combination",
    "correction_cases": "case_with_the_highest_mean_validation_session_ic_common_to_the_seeds",
    "sensitivity": "the_session_mae_best_epoch_of_each_seed_is_reported_and_never_emitted",
    "retention": "every_epoch_state_is_pinned_until_its_window_confirms_its_predictions_and_then_released",
    "versions": {
      "epochs": [3, 6, 9, 12],
      "models": ["references/quantile_reference", "F1/laplace_scale_head", "F4/session_ic_objective", "F5/auxiliary_horizons", "C6/competition"],
      "partitions": ["calibration", "evaluation"],
      "consumer": "version_arbiter_v1 de #789",
      "reason": "La referencia B y cuatro variantes que cambian la pérdida, el objetivo, la supervisión auxiliar y la memoria. F2 y F3 ya promedian en el tiempo los pesos, así que el árbitro se compara con ellas sobre la referencia en lugar de aplicarse encima"
    },
    "rule_check": {
      "partition": "validation",
      "choose_months": 4,
      "measure_months": 2,
      "compared": ["common_epoch_session_ic_v1", "session_mae_best_epoch_of_each_seed", "last_epoch"],
      "bound": "best_epoch_of_the_measured_months_reported_as_a_bound_with_future_information",
      "device": "cpu_only"
    },
    "amendment": {
      "date": "2026-10-28",
      "issue": 746,
      "registered_before_opening_s": true,
      "previous_rule": "best_validation_session_mae_within_the_fixed_budget",
      "reason": "El contraste principal se juzga con el IC por sesión y el MAE de un residuo diario premia las predicciones pequeñas, así que podía quedarse con épocas que apenas ordenan los activos. Elegir el máximo de doce valores ruidosos por semilla añade sesgo de selección. Una época común para las semillas, suavizada con sus vecinas, reduce la varianza del criterio y mantiene iguales las actualizaciones",
      "sources": ["Cawley y Talbot (2010), JMLR 11", "Ranjan y otros (2024), NeurIPS", "Gulrajani y Lopez-Paz (2021), ICLR"]
    }
  },
  "references": {
    "quantile_reference": {
      "runner": "fit",
      "base_recipe": "configs/titans/chronological-training-historical-sequence-v1.json",
      "predictor_changes": {},
      "recipe_changes": {},
      "role": "Referencia B con la cabeza de cuantiles y pinball. Es el padre de las correcciones y la fuente de las etapas de salida"
    },
    "scalar_reference": {
      "runner": "fit",
      "base_recipe": "configs/titans/chronological-training-historical-sequence-v1.json",
      "head": "scalar",
      "loss": "mae",
      "predictor_changes": {},
      "recipe_changes": {},
      "role": "Referencia con la cabeza escalar y MAE de los objetivos de salida"
    },
    "regional_reference": {
      "runner": "fit",
      "base_recipe": "configs/experiments/regional-fusion-recipe-v1.json",
      "predictor_changes": {
        "regional_fusion": {"topology": "ring", "routing": "attention", "cycles": 2, "local_steps": 2, "summary": true, "local_gain": 0.25, "summary_gain": 0.25}
      },
      "recipe_changes": {},
      "role": "Operador regional en anillo con resumen que sustituyen C1 y C6"
    },
    "reader_reference": {
      "runner": "reader",
      "parent": "quantile_reference",
      "recipe": "configs/titans/episodic-readout-historical-masked.json",
      "components": {"episodic_bank": "m1"},
      "recipe_changes": {},
      "role": "Lector M1 con K = 1 sobre el padre congelado. Es el ancla de E2"
    }
  },
  "contrast": {
    "primary": {
      "metric": "session_ic",
      "definition": "Media sobre las sesiones de S de la correlación de Pearson por sesión entre la predicción emitida y el residuo, promediada entre semillas, del modelo menos la de su control",
      "minimum_assets": 3,
      "direction": "greater",
      "margin": 0.0
    },
    "amplitude": {
      "metric": "session_mae_calibrated",
      "definition": "MAE por sesión de λ·predicción con λ por mercado elegido en la calibración de su origen, del modelo menos el de su control",
      "direction": "less",
      "margin": 0.0,
      "applies_to": "variants_that_cannot_change_the_order_within_a_session_by_construction"
    },
    "secondary": [
      "session_rank_ic",
      "session_mae_calibrated",
      "session_mae_raw",
      "session_mae_minus_zero"
    ],
    "seed_aggregation": "mean_of_the_seed_metrics_in_each_session",
    "origins_aggregation": "the_screening_sessions_of_the_four_origins_form_one_2019_2022_series"
  },
  "inference": {
    "resampling": "circular_block_bootstrap_of_utc_days",
    "block_days": 16,
    "sensitivity_block_days": [8, 32],
    "replicates": 2000,
    "seed": 20261023,
    "confidence": 0.95,
    "family_correction": "romano_wolf_stepdown_max_t",
    "robustness": "holm_on_the_bootstrap_p_values",
    "required_contrasts": "intersection_union_every_required_control_must_pass_without_further_correction",
    "minimum_detectable_effect": {"alpha": 0.05, "power": 0.8}
  },
  "families": {
    "declared": "primary_contrast_of_every_catalog_entry_with_its_metric",
    "sensitivity": [
      "one_family_per_catalog_group",
      "every_declared_contrast_of_the_screening"
    ],
    "reason": "La fase 0 mostró que la conclusión sobre el IC cambiaba al redefinir la familia. Se publican las tres definiciones y decide la declarada"
  },
  "decision": {
    "passes": "simultaneous_interval_of_the_declared_family_excludes_zero_in_the_favourable_direction_with_16_day_blocks_and_every_required_contrast_passes",
    "reported": "survival_with_8_and_32_day_blocks_holm_and_both_sensitivity_families",
    "after": "Pasar la criba no confirma una mejora. La confirmación con 2023, 128 activos y China por separado necesita otra aprobación"
  },
  "common_controls": {
    "zero": "predecir residuo cero",
    "reference": "quantile_reference o scalar_reference según la cabeza del modelo",
    "past_median": "mediana de las 60 últimas etiquetas maduras del activo con dos sesiones de retraso, como en la fase 0",
    "momentum_reversal": "pendiente de implementar como regla sin aprendizaje",
    "lightgbm": "pendiente de implementar con las mismas características",
    "nadaraya_watson": "control de B1 en su declaración"
  },
  "catalog": {
    "A1": {
      "identity": "scale_shrink_v1",
      "runner": "output",
      "source": "quantile_reference",
      "metric": "session_mae_calibrated",
      "arms": {
        "shrink": {"stage": "market_lambda_of_the_calibration"},
        "raw": {"stage": "none"}
      },
      "primary": ["shrink", "zero"],
      "reported": [["shrink", "raw"]],
      "note": "Un λ positivo por mercado no cambia el orden dentro de una sesión, así que el IC no puede descartarla"
    },
    "A2": {
      "identity": "neutral_abstention_v1",
      "runner": "output",
      "source": "quantile_reference",
      "metric": "session_mae_calibrated",
      "arms": {
        "abstention": {"stage": {"neutral_abstention_v1": {"nominal": 0.8, "min_rows": 1000, "random_seed": 20261023, "volatility_window": 60, "volatility_min_labels": 20}}},
        "random": {"stage": "matched_control", "control": "random"},
        "small_prediction": {"stage": "matched_control", "control": "small_prediction"},
        "past_volatility": {"stage": "matched_control", "control": "past_volatility"},
        "seed_disagreement": {"stage": "matched_control", "control": "seed_disagreement"},
        "median": {"stage": "none"}
      },
      "primary": ["abstention", "random"],
      "required": [["abstention", "small_prediction"], ["abstention", "past_volatility"], ["abstention", "seed_disagreement"]],
      "reported": [["abstention", "median"], ["abstention", "zero"]]
    },
    "A3": {
      "identity": "regime_weighted_conformal_v1",
      "runner": "output",
      "source": "quantile_reference",
      "metric": "session_mae_calibrated",
      "arms": {
        "context": {"stage": {"regime_weighted_conformal_v1": {"bandwidth": 0.5, "lookback_days": 120, "regime_days": 30, "min_rows": 1000, "seed": 20261027}}, "weighting": "context", "then": "A2.abstention"},
        "uniform": {"stage": {"regime_weighted_conformal_v1": {"bandwidth": 0.5, "lookback_days": 120, "regime_days": 30, "min_rows": 1000, "seed": 20261027}}, "weighting": "uniform", "then": "A2.abstention"},
        "shuffled": {"stage": {"regime_weighted_conformal_v1": {"bandwidth": 0.5, "lookback_days": 120, "regime_days": 30, "min_rows": 1000, "seed": 20261027}}, "weighting": "shuffled", "then": "A2.abstention"}
      },
      "primary": ["context", "uniform"],
      "required": [["context", "shuffled"]],
      "reported": [["context", "A2.abstention"]],
      "note": "A3 solo recalibra intervalos. Se contrasta a través de la abstención de A2. La cobertura y el interval score por año se publican como diagnóstico"
