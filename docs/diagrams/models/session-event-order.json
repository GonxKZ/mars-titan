  "cards": [
    {
      "dot": "cyan",
      "title": "Antes de emitir",
      "items": [
        "Se valida el corte t y se carga la generación confirmada g − 1",
        "La instantánea del banco y la matriz A son las mismas para todos los activos y pasos K",
        "prepare lee M_{t−1}, aplica la atención, escribe M_t una vez y refina sin escribir memoria"
      ]
    },
    {
      "dot": "rose",
      "title": "Después de emitir",
      "items": [
        "Los resultados que maduran en t se resuelven contra la predicción emitida",
        "Las escrituras del banco y de A se proponen sobre copias",
        "La generación g se publica de forma atómica y actúa desde el evento siguiente"
      ]
    },
    {
      "dot": "amber",
      "title": "Fuera de la sesión",
      "items": [
        "Ajuste de parámetros, replay y adaptadores solo en entrenamiento o postentrenamiento",
        "Recuperación desde la generación confirmada, con cola, cursor y RNG"
      ]
    }
