  "mainPath": ["validate", "route", "snapshot", "prepare", "queue", "resolve", "publish"],
  "nodes": [
    {"id": "validate", "lane": "event", "col": 0, "type": "security", "label": "Validar el evento", "sublabel": "corte y prefijo", "width": 176},
    {"id": "route", "lane": "event", "col": 1, "type": "external", "label": "Ruta de régimen", "sublabel": "si B6 está enrutada", "width": 176},
