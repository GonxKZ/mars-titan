ck::now() - started).count();\n        allocations = 0; allocated_bytes = 0; tracking = true;\n        const auto result = china_a_share_rules(\"600000.SH\", status);\n        tracking = false;\n        std::uint64_t content = 1469598103934665603ULL;\n        for (const auto& item : result.price_limits) {\n            for (auto value : {static_cast<std::uint64_t>(item.start), static_cast<std::uint64_t>(item.end), std::bit_cast<std::uint64_t>(item.band), std::bit_cast<std::uint64_t>(item.buy), std::bit_cast<std::uint64_t>(item.sell)}) {\n                content = (content ^ value) * 1099511628211ULL;\n            }\n        }\n        std::cout << \"{\\\"days\\\":\" << days << \",\\\"iterations\\\":\" << repeats\n                  << \",\\\"seconds\\\":\" << seconds << \",\\\"allocations\\\":\" << allocations\n                  << \",\\\"allocated_bytes\\\":\" << allocated_bytes << \",\\\"content_hash\\\":\" << content\n                  << \",\\\"checksum\\\":\" << digest << \"}\\n\";\n    }\n}\n"
