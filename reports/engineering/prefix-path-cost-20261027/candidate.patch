@@ -0,0 +1,30 @@
+"""La comprobación de rutas conserva la evidencia de prefijo con supervisión manual."""
+
+from test_financial_session import moment
+from test_financial_session_controls import flow_source
+from test_financial_session_controls import no_target_estimation as no_target_estimation
+
+from mars_titan.data.cohort_files import safe_destination
+from mars_titan.training import prefix_eligibility as api
+
+
+def original_signature(path):
+    safe_destination(path)
+    info = path.stat()
+    if not path.is_file():
+        raise ValueError("La fuente del prefijo no es un archivo regular")
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
+
+
+def test_prefix_evidence_and_policy_are_identical_to_the_original(tmp_path, monkeypatch):
+    source = flow_source(tmp_path, flows=("US/T0000",))
+    verifier = source["prefixes"]
+    before_policy = verifier.identity()
+    with monkeypatch.context() as guard:
+        guard.setattr(api, "_signature", original_signature)
+        expected = [verifier.evidence("US/T0000", moment(index)) for index in (125, 126, 128, 130)]
+    actual = [verifier.evidence("US/T0000", moment(index)) for index in (125, 126, 128, 130)]
+    assert actual == expected
+    assert verifier.identity() == before_policy
+    for proof in actual:
+        assert verifier.verify(proof, flow_id=proof.flow_id, decision_at=proof.decision_at) is None
