@@ -0,0 +1,126 @@
+"""Firmas de archivo sin caché, con revisión de enlaces y lectura final del objetivo."""
+
+import os
+from pathlib import Path
+
+import pytest
+
+from mars_titan.training import prefix_eligibility as api
+
+
+def attributes(info):
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
+
+
+@pytest.mark.parametrize("relative", [False, True])
+def test_regular_file_keeps_all_five_attributes(tmp_path, monkeypatch, relative):
+    target = tmp_path / "a/b/target.bin"
+    target.parent.mkdir(parents=True)
+    target.write_bytes(b"fixture")
+    os.utime(target, ns=(11, 13))
+    if relative:
+        monkeypatch.chdir(tmp_path)
+        target = Path("a/b/target.bin")
+    assert api._signature(target) == attributes(target.stat())
+
+
+def test_each_read_uses_at_most_two_target_metadata_calls(tmp_path, monkeypatch):
+    target = tmp_path / "target.bin"
+    target.write_bytes(b"fixture")
+    original_stat, original_lstat = os.stat, os.lstat
+    calls = []
+
+    def observe(function):
+        def wrapped(path, *args, **kwargs):
+            if os.fspath(path) == os.fspath(target):
+                calls.append(path)
+            return function(path, *args, **kwargs)
+
+        return wrapped
+
+    monkeypatch.setattr(os, "stat", observe(original_stat))
+    monkeypatch.setattr(os, "lstat", observe(original_lstat))
+    first = api._signature(target)
+    assert 1 <= len(calls) <= 2
+    calls.clear()
+    assert api._signature(target) == first
+    assert 1 <= len(calls) <= 2
+
+
+@pytest.mark.parametrize("kind", ["directory", "fifo", "link", "dangling"])
+def test_nonregular_sources_are_rejected_without_opening_them(tmp_path, kind):
+    target = tmp_path / "target"
+    if kind == "directory":
+        target.mkdir()
+    elif kind == "fifo":
+        os.mkfifo(target)
+    else:
+        actual = tmp_path / "actual"
+        if kind == "link":
+            actual.write_bytes(b"fixture")
+        target.symlink_to(actual)
+    with pytest.raises(ValueError):
+        api._signature(target)
+
+
+def test_an_ancestor_link_to_the_same_inode_is_not_hidden_by_a_cached_signature(tmp_path):
+    parent = tmp_path / "parent"
+    parent.mkdir()
+    target = parent / "target.bin"
+    target.write_bytes(b"fixture")
+    previous = api._signature(target)
+    actual = tmp_path / "actual"
+    parent.rename(actual)
+    parent.symlink_to(actual, target_is_directory=True)
+    assert attributes(target.stat()) == previous
+    with pytest.raises(ValueError):
+        api._signature(target)
+
+
+def during_parent_check(monkeypatch, target, change):
+    original_stat, original_lstat = os.stat, os.lstat
+    changed = False
+
+    def observe(function):
+        def wrapped(path, *args, **kwargs):
+            nonlocal changed
+            if not changed and os.fspath(path) == os.fspath(target.parent):
+                changed = True
+                change()
+            return function(path, *args, **kwargs)
+
+        return wrapped
+
+    monkeypatch.setattr(os, "stat", observe(original_stat))
+    monkeypatch.setattr(os, "lstat", observe(original_lstat))
+
+
+def test_signature_reads_target_changes_after_checking_ancestors(tmp_path, monkeypatch):
+    target = tmp_path / "parent/target.bin"
+    target.parent.mkdir()
+    target.write_bytes(b"before")
+    before = attributes(target.stat())
+    during_parent_check(monkeypatch, target, lambda: target.write_bytes(b"after with new length"))
+    result = api._signature(target)
+    assert result != before
+    assert result == attributes(target.stat())
+
+
+def test_target_link_inserted_during_ancestor_check_is_rejected(tmp_path, monkeypatch):
+    target = tmp_path / "parent/target.bin"
+    target.parent.mkdir()
+    target.write_bytes(b"fixture")
+    actual = target.with_name("actual.bin")
+
+    def replace_target():
+        target.rename(actual)
+        target.symlink_to(actual)
+
+    during_parent_check(monkeypatch, target, replace_target)
+    with pytest.raises(ValueError):
+        api._signature(target)
+
+
+def test_missing_source_keeps_the_operating_system_failure(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        api._signature(tmp_path / "missing")
