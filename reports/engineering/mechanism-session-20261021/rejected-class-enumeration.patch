+def _class_functions(kind):
+    """Funciones actuales de la clase, con la misma resolución que inspect.
+
+    Las clases ordinarias se resuelven por MRO sin enlazar cada atributo. Los
+    descriptores no estándar y las metaclases mantienen la inspección completa.
+    No se conserva una caché entre auditorías.
+    """
+    if type(kind) is not type:
+        return tuple(inspect.getmembers(kind, inspect.isfunction))
+    resolved = {}
+    for base in reversed(kind.__mro__):
+        resolved.update(vars(base))
+    functions = []
+    ordinary_descriptors = (
+        property,
+        types.GetSetDescriptorType,
+        types.MemberDescriptorType,
+        types.MethodDescriptorType,
+        types.WrapperDescriptorType,
+        types.ClassMethodDescriptorType,
+        types.BuiltinFunctionType,
+    )
+    for name, value in resolved.items():
+        value_type = type(value)
+        if value_type is types.FunctionType:
+            functions.append((name, value))
+        elif value_type is staticmethod:
+            if inspect.isfunction(value.__func__):
+                functions.append((name, value.__func__))
+        elif value_type is classmethod and type(value.__func__) is types.FunctionType:
+            continue
+        elif value_type not in ordinary_descriptors and (
+            type(value_type) is not type
+            or any("__get__" in vars(base) for base in value_type.__mro__)
+        ):
+            return tuple(inspect.getmembers(kind, inspect.isfunction))
+        elif inspect.isfunction(value):
+            functions.append((name, value))
+    return tuple(sorted(functions))
